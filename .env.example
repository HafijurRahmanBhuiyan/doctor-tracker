# Compose defaults work without a .env file. Change the JWT secret for any real deployment.
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://mongo:27017/doctor-tracker
JWT_SECRET=dev-only-change-me-before-deployment
JWT_EXPIRES_IN=7d
# Comma-separated allowed browser origins; localhost remains allowed for local use.
CLIENT_URL=http://localhost:3000
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=20
# Public values are baked into the frontend image at build time.
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
